// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
}


enum AccountType {
  CHECKING  // Conta corrente: não rende (ex: C6, Bradesco)
  YIELDING  // Conta remunerada: rende % do CDI (ex: Mercado Pago)
}

enum WorkspaceMemberStatus {
  ACTIVE
  SUSPENDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Plan {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String?
  allowedModules String[]
  isDefault      Boolean  @default(false)

  users          User[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String?
  googleId           String?  @unique
  isActive           Boolean  @default(true)
  isSuperAdmin       Boolean  @default(false)
  defaultWorkspaceId String?
  planId             String?
  plan               Plan?    @relation(fields: [planId], references: [id])

  memberships        WorkspaceUser[]
  sentInvites        WorkspaceInvite[] @relation("InvitesSent")
  createdWorkspaces  Workspace[]       @relation("WorkspaceCreator")
  dashboardLayouts   DashboardLayout[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdById String
  createdBy   User     @relation("WorkspaceCreator", fields: [createdById], references: [id])

  members             WorkspaceUser[]
  invites             WorkspaceInvite[]
  roles               Role[]
  accounts            Account[]
  categories          Category[]
  transactions        Transaction[]
  creditCards         CreditCard[]
  cardTransactions    CardTransaction[]
  recurringExpenses   RecurringExpense[]
  investments         Investment[]
  milesEntries        MilesEntry[]
  balanceAdjustments  BalanceAdjustment[]
  accountTransfers       AccountTransfer[]
  dashboardLayouts       DashboardLayout[]
  openFinanceConnections OpenFinanceConnection[]
  financings             Financing[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String     @id @default(uuid())
  code        String
  name        String
  description String?
  isSystem    Boolean    @default(true)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  members     WorkspaceUser[]
  invites     WorkspaceInvite[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code, workspaceId])
  @@index([workspaceId])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  action      String
  description String

  roles       RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model WorkspaceUser {
  id          String                @id @default(uuid())
  workspaceId String
  userId      String
  roleId      String
  status      WorkspaceMemberStatus @default(ACTIVE)
  joinedAt    DateTime              @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, roleId])
}

model WorkspaceInvite {
  id          String       @id @default(uuid())
  workspaceId String
  email       String
  roleId      String
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy   User      @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([workspaceId, status])
  @@index([email, status])
}

model Account {
  id                   String      @id @default(uuid())
  workspaceId          String?
  workspace            Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                 String
  balance              Float       @default(0)
  currency             String      @default("BRL") // "BRL" | "USD"
  balanceUsd           Float?      // Saldo em US$ quando a conta é em dólar
  investedBrl          Float?      // Valor total gasto em R$ no momento da compra do dólar
  purchaseExchangeRate Float?      // Cotação do dólar (R$/US$) paga no momento da compra
  type                 AccountType @default(CHECKING)
  cdiPercentage        Float?      // Só para contas remuneradas, ex: 100 = 100% do CDI
  hasIof               Boolean     @default(false) // Se incide IOF sobre os rendimentos nos primeiros 30 dias (padrão Mercado Pago = false/isento)
  yieldSince           DateTime?   // Dia a partir do qual a conta remunerada passa a render (sem retroativo)
  yields               AccountYield[]
  pots                 YieldPot[]
  transfersOut         AccountTransfer[] @relation("TransfersOut")
  transfersIn          AccountTransfer[] @relation("TransfersIn")
  adjustments          BalanceAdjustment[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  
  transactions Transaction[]
  creditCards  CreditCard[]
  recurringExpenses      RecurringExpense[]
  investments            Investment[]
  openFinanceAccountMaps OpenFinanceAccountMap[]

  @@index([workspaceId])
}

model Category {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  icon        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  transactions      Transaction[]
  cardTransactions  CardTransaction[]
  recurringExpenses RecurringExpense[]

  @@index([workspaceId])
}

model Transaction {
  id                 String   @id @default(uuid())
  workspaceId        String?
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  description        String
  amount             Float
  date               DateTime
  type               TransactionType
  status             TransactionStatus @default(PENDING)
  isFixed            Boolean  @default(false)
  fixedUntil         DateTime? // Conta fixa encerrada: não é mais projetada em meses depois desta data
  installments       Int      @default(1)
  installmentGroupId String?
  externalId         String?  @unique
  
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([installmentGroupId])
  @@index([workspaceId, date])
}

model CreditCard {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  limit                 Float
  invoiceClosingOffset  Int      @default(7)
  dueDay                Int
  color       String?

  // Rewards: points earned per US$ spent, and the program they accrue to (e.g. Livelo, Esfera)
  pointsPerDollar Float?
  loyaltyProgram  String?

  // Favorite card: shown first and featured on the summary page (only one at a time)
  isPrimary   Boolean  @default(false)

  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  
  transactions CardTransaction[]
  holders                CardHolder[]
  milesEntries           MilesEntry[]
  openFinanceAccountMaps OpenFinanceAccountMap[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

// Portador de um cartão: o titular e os cartões adicionais compartilham limite e fatura
model CardHolder {
  id           String   @id @default(uuid())
  creditCardId String
  creditCard   CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  name         String
  last4        String?
  isMain       Boolean  @default(false)

  transactions CardTransaction[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([creditCardId, name])
  @@index([creditCardId])
}

model CardTransaction {
  id          String   @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  invoiceDate DateTime // Reference invoice date calculated purely from the purchase and card closing dates
  installments Int     @default(1)
  isFixed     Boolean  @default(false)
  ignoredInvoices String? // Comma-separated or stringified JSON of "YYYY-MM" to skip when projecting fixed expenses
  
  creditCardId String
  creditCard   CreditCard @relation(fields: [creditCardId], references: [id])

  cardHolderId String
  cardHolder   CardHolder @relation(fields: [cardHolderId], references: [id], onDelete: Restrict)
  
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  
  installmentGroupId String?
  externalId         String?  @unique
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cardHolderId])
  @@index([workspaceId, invoiceDate])
}

model RecurringExpense {
  id          String   @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  billingDay  Int      // 1 to 31
  isActive    Boolean  @default(true)
  
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

enum InvestmentType {
  FIXED_INCOME
  VARIABLE_INCOME
  FII
  CRYPTO
  US_STOCK
  OTHER
}

model Investment {
  id             String         @id @default(uuid())
  workspaceId    String?
  workspace      Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  type           InvestmentType
  investedAmount Float
  currentValue   Float          // For manual tracking overriding simulation, default behavior uses this.
  
  investmentDate DateTime?      // Date the investment started (essential for CDB tax)
  cdiPercentage  Float?         // % of CDI rate for fixed income calculations

  // Variable income fields
  sector         String?        // Ramo de atuação (ex: Tecnologia, Energia)
  tickerCode     String?        // Código da ação/FII (ex: PETR4, HGLG11)
  averagePrice   Float?         // Preço médio de compra
  currentPrice   Float?         // Preço atual da cota/ação
  quantity       Float?         // Quantidade de cotas/ações (Float for fractional)

  // US stocks/ETFs: averagePrice/currentPrice are in USD
  purchaseExchangeRate Float?   // Cotação do dólar (BRL) usada na compra

  accountId       String?
  account         Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountLinkedAt DateTime?

  dividends      InvestmentDividend[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([workspaceId, type])
  @@index([accountId])
}

model InvestmentDividend {
  id                String     @id @default(uuid())
  investmentId      String
  investment        Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  tickerCode        String
  date              DateTime
  amountPerShare    Float
  quantity          Float
  totalOriginal     Float
  currency          String     @default("BRL")
  totalBrl          Float
  creditedAccountId String?
  creditedAt        DateTime?
  createdAt         DateTime   @default(now())

  @@unique([investmentId, date, amountPerShare])
  @@index([investmentId])
  @@index([date])
}

enum MilesStatus {
  PENDING      // Pendente: pontos ainda não caíram no programa
  TRANSFERRED  // Transferido: enviado para o programa de destino
  CREDITED     // Creditado: disponível na conta
}

model MilesEntry {
  id                 String      @id @default(uuid())
  workspaceId        String?
  workspace          Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  program            String      // Programa de fidelidade (ex: Livelo, Esfera, Smiles)
  points             Int
  status             MilesStatus @default(PENDING)
  expectedCreditDate DateTime    // Previsão de crédito na conta

  // Origem: um cartão cadastrado ou um texto livre (ex: "Compra bonificada")
  creditCardId       String?
  creditCard         CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  origin             String?

  // Fatura de referência quando o lançamento vem da estimativa do cartão
  referenceMonth     Int?
  referenceYear      Int?
  notes              String?

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status])
  @@index([expectedCreditDate])
  @@index([workspaceId, status])
}

// Ajuste manual do saldo de uma conta (editar/zerar saldo): não é receita nem despesa.
// Fica registrado com data para o rendimento de contas remuneradas mudar a partir desse dia.
model BalanceAdjustment {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount      Float      // diferença aplicada ao saldo (+ ou -)
  date        DateTime   @default(now())
  createdAt   DateTime   @default(now())

  @@index([accountId])
  @@index([workspaceId])
}

// Transferência entre contas próprias: não é receita nem despesa, só move saldo
model AccountTransfer {
  id            String     @id @default(uuid())
  workspaceId   String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromAccountId String
  fromAccount   Account    @relation("TransfersOut", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     Account    @relation("TransfersIn", fields: [toAccountId], references: [id])
  amount        Float
  date          DateTime   // Dia em que o dinheiro saiu de uma conta e entrou na outra
  description   String?
  createdAt     DateTime   @default(now())

  @@index([date])
  @@index([workspaceId, date])
}

// Cofrinho dentro de uma conta remunerada, com % do CDI próprio
model YieldPot {
  id            String        @id @default(uuid())
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  cdiPercentage Float         // ex: 120 = 120% do CDI
  balance       Float         @default(0) // Saldo do cofrinho (já incluído no saldo da conta)
  movements     PotMovement[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Guardar (+) ou retirar (-) dinheiro de um cofrinho; o valor vem/volta do saldo livre da conta
model PotMovement {
  id        String   @id @default(uuid())
  potId     String
  pot       YieldPot @relation(fields: [potId], references: [id], onDelete: Cascade)
  amount    Float
  kind      String   @default("transfer") // "transfer" (guardar/retirar do saldo livre) | "adjustment" (acerto com o app do banco)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

// Rendimento diário creditado em contas remuneradas: um registro por conta, por "bucket"
// (saldo livre da conta = "main", ou o id do cofrinho) e por dia útil
model AccountYield {
  id            String   @id @default(uuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bucket        String   @default("main") // "main" ou id do cofrinho
  date          DateTime @db.Date // Dia útil do CDI que gerou o rendimento
  cdiDailyRate  Float    // Taxa diária do CDI em % (série 12 do BCB)
  cdiPercentage Float    // % do CDI do bucket no dia
  balanceBefore Float    // Saldo do bucket no fim do dia
  grossAmount   Float
  irRate        Float    @default(0.225) // Alíquota efetiva do dia (média ponderada dos lotes)
  taxAmount     Float    // IR retido no dia (cada lote na sua faixa)
  netAmount     Float    // Rendimento líquido do dia (bruto - IR)
  taxRefund     Float    @default(0) // IR devolvido dos lotes que mudaram de faixa
  createdAt     DateTime @default(now())

  @@unique([accountId, bucket, date])
}

// Layout personalizado do Resumo: ordem e largura dos blocos por workspace/usuário
model DashboardLayout {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       Json
  updatedAt   DateTime   @updatedAt

  @@unique([workspaceId, userId])
}

model OpenFinanceConnection {
  id               String                  @id @default(uuid())
  workspaceId      String
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider         String                  @default("PLUGGY")
  itemId           String                  @unique
  institutionName  String
  status           String                  @default("UPDATED")
  consentExpiresAt DateTime?
  lastSyncedAt     DateTime?
  accountMaps      OpenFinanceAccountMap[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([workspaceId])
}

model OpenFinanceAccountMap {
  id                String                @id @default(uuid())
  connectionId      String
  connection        OpenFinanceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalAccountId String                @unique
  externalName      String
  externalType      String                // "BANK" | "CREDIT"
  externalSubtype   String?
  localAccountId    String?
  localAccount      Account?              @relation(fields: [localAccountId], references: [id], onDelete: SetNull)
  localCreditCardId String?
  localCreditCard   CreditCard?           @relation(fields: [localCreditCardId], references: [id], onDelete: SetNull)
  syncEnabled       Boolean               @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([connectionId])
}

enum AmortizationSystem {
  SAC
  PRICE
}

enum FinancingIndexer {
  TR
  IPCA
  POUPANCA
  FIXO
}

enum FinancingInstallmentStatus {
  PAID
  PENDING
}

enum ExtraAmortizationStrategy {
  REDUCE_TERM
  REDUCE_INSTALLMENT
}

enum ExtraAmortizationSource {
  OWN_FUNDS
  FGTS
}

model Financing {
  id                  String               @id @default(uuid())
  workspaceId         String
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String
  bankName            String
  contractNumber      String?
  propertyAddress     String?
  system              AmortizationSystem   @default(SAC)
  indexer             FinancingIndexer     @default(TR)
  propertyValue       Float
  downPayment         Float                @default(0)
  financedAmount      Float
  currentBalance      Float
  nominalRateAnnual   Float
  effectiveRateAnnual Float?
  cetAnnual           Float?
  totalMonths         Int
  dueDay              Int                  @default(21)
  contractDate        DateTime
  releaseDate         DateTime?
  monthlyAdminFee     Float                @default(25)
  monthlyInsurance    Float                @default(0)
  fgtsBalance            Float                @default(0)
  lastFgtsUsageDate      DateTime?
  linkedFixedDescription String?
  notes                  String?

  installments        FinancingInstallment[]
  extraAmortizations  FinancingExtraAmortization[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([workspaceId])
}

model FinancingInstallment {
  id                 String                     @id @default(uuid())
  financingId        String
  financing          Financing                  @relation(fields: [financingId], references: [id], onDelete: Cascade)
  installmentCode    String
  installmentNumber  Int?
  dueDate            DateTime
  paidDate           DateTime?
  status             FinancingInstallmentStatus @default(PENDING)
  totalAmount        Float
  principalAmount    Float
  interestAmount     Float
  mipAmount          Float                      @default(0)
  dfiAmount          Float                      @default(0)
  tsaAmount          Float                      @default(0)
  fineAmount         Float                      @default(0)
  monetaryCorrection Float                      @default(0)
  paidAmount         Float                      @default(0)
  balanceAfter       Float

  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([financingId, installmentCode])
  @@index([financingId, status])
  @@index([financingId, dueDate])
}

model FinancingExtraAmortization {
  id                  String                    @id @default(uuid())
  financingId         String
  financing           Financing                 @relation(fields: [financingId], references: [id], onDelete: Cascade)
  date                DateTime
  amount              Float
  strategy            ExtraAmortizationStrategy @default(REDUCE_TERM)
  source              ExtraAmortizationSource   @default(OWN_FUNDS)
  installmentsReduced Int                       @default(0)
  notes               String?

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([financingId, date])
}
